# 打包產出：用 python tools/build.py 重新產生
dist/

# Python（tools/ 的腳本）
__pycache__/
*.pyc

# 編輯器的本機設定；.claude/ 裡的 hooks、skills 是專案的一部分，只有個人的 settings.local.json 不進版本控制
.claude/settings.local.json
.vscode/
.idea/

# 系統檔
.DS_Store
Thumbs.db
desktop.ini

# 記錄檔
*.log

# 測試執行中的標記（tests/run.mjs 結束時自動刪除）
tests/.running-*
